{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>1024pix/renovate-config:default"
    ],
    "enabled": true,
    "forkProcessing": "enabled",
    "minimumReleaseAge": "0",
    "schedule": ["* * * * 1-5"],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^bin/version$/"
            ],
            "matchStrings": [
                "^(?<currentValue>\\S+)\\n?$"
            ],
            "depNameTemplate": "privatebin/privatebin",
            "datasourceTemplate": "github-tags",
            "extractVersionTemplate": "(?<version>.*)"
        }
    ]
}
